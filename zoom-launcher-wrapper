#!/bin/bash
# zoom-launcher-wrapper:
# Ensures V4L2 camera pipelines are actively streaming into /dev/video* BEFORE Zoom
# performs its one-time device enumeration at startup.

# 1. Trigger the camera bridge daemon to start feeding /dev/video* immediately
if [ -e /dev/video0 ]; then
    if [ -x /usr/local/bin/xrdp-v4l2-bridge.py ]; then
        /usr/local/bin/xrdp-v4l2-bridge.py --wake 2>/dev/null || true
    else
        touch /tmp/.xrdp-camera-wake 2>/dev/null || true
        pkill -USR1 -f xrdp-v4l2-bridge.py 2>/dev/null || true
    fi

    # Wait up to 3 seconds for /dev/video0 to enter Video Capture mode with active frames
    for i in $(seq 1 30); do
        if v4l2-ctl -d /dev/video0 --all 2>/dev/null | grep -qi "Video Capture"; then
            break
        fi
        sleep 0.1
    done
fi

# 2. Locate the real Zoom executable
REAL_ZOOM=""
if [ -x /opt/zoom/ZoomLauncher ]; then
    REAL_ZOOM="/opt/zoom/ZoomLauncher"
elif [ -x /opt/zoom/zoom ]; then
    REAL_ZOOM="/opt/zoom/zoom"
elif [ -x /usr/bin/zoom.real ]; then
    REAL_ZOOM="/usr/bin/zoom.real"
fi

if [ -n "$REAL_ZOOM" ]; then
    exec "$REAL_ZOOM" "$@"
else
    echo "Error: Zoom executable not found in /opt/zoom/" >&2
    exit 1
fi
