#!/bin/bash
# Universal wrapper for Chromium-based browsers (Edge, Chrome, Chromium, Brave)
# Automatically enables WebRtcPipeWireCamera so redirected webcams work out of the box.

TARGET="$(basename "$0")"

REAL_BIN=""
case "$TARGET" in
    *edge*)
        for p in "/opt/microsoft/msedge/microsoft-edge" "/opt/microsoft/msedge/msedge" "/opt/microsoft/msedge-beta/microsoft-edge" "/opt/microsoft/msedge-dev/microsoft-edge"; do
            [ -x "$p" ] && REAL_BIN="$p" && break
        done
        ;;
    *chrome*)
        for p in "/opt/google/chrome/google-chrome" "/opt/google/chrome/chrome" "/opt/google/chrome-beta/google-chrome"; do
            [ -x "$p" ] && REAL_BIN="$p" && break
        done
        ;;
    *brave*)
        for p in "/opt/brave.com/brave/brave-browser" "/opt/brave.com/brave/brave"; do
            [ -x "$p" ] && REAL_BIN="$p" && break
        done
        ;;
    *chromium*)
        for p in "/usr/lib/chromium-browser/chromium-browser" "/usr/lib/chromium/chromium"; do
            [ -x "$p" ] && REAL_BIN="$p" && break
        done
        ;;
esac

# Fallback search outside /usr/local/bin and /usr/bin if wrapper replaced /usr/bin symlink
if [ -z "$REAL_BIN" ]; then
    CLEAN_PATH=$(echo "$PATH" | tr ':' '\n' | grep -v '^/usr/local/bin' | grep -v '^/usr/bin' | paste -sd:)
    for candidate in $(PATH="$CLEAN_PATH" which -a "$TARGET" 2>/dev/null); do
        if [ "$(realpath "$candidate" 2>/dev/null)" != "$(realpath "$0" 2>/dev/null)" ]; then
            REAL_BIN="$candidate"
            break
        fi
    done
fi

if [ -z "$REAL_BIN" ] || [ ! -x "$REAL_BIN" ]; then
    echo "Browser executable '$TARGET' not found." >&2
    exit 1
fi

# Inject WebRtcPipeWireCamera into --enable-features if not already present
case "$*" in
    *WebRtcPipeWireCamera*)
        exec "$REAL_BIN" "$@"
        ;;
    *--enable-features=*)
        ARGS=()
        for arg in "$@"; do
            if [[ "$arg" =~ ^--enable-features= ]]; then
                ARGS+=("${arg/--enable-features=/--enable-features=WebRtcPipeWireCamera,}")
            else
                ARGS+=("$arg")
            fi
        done
        exec "$REAL_BIN" "${ARGS[@]}"
        ;;
    *)
        exec "$REAL_BIN" --enable-features=WebRtcPipeWireCamera "$@"
        ;;
esac
