#!/bin/bash
# obs-launcher-wrapper:
# Ensures V4L2 camera pipelines are streaming, default scene/device configurations exist,
# and V4L2 compatibility shims are loaded before OBS Studio starts.

# 1. Trigger the camera bridge daemon to start feeding /dev/video* immediately
if [ -e /dev/video0 ]; then
    if [ -x /usr/local/bin/xrdp-v4l2-bridge.py ]; then
        /usr/local/bin/xrdp-v4l2-bridge.py --wake 2>/dev/null || true
    else
        touch /tmp/.xrdp-camera-wake 2>/dev/null || true
        pkill -USR1 -f xrdp-v4l2-bridge.py 2>/dev/null || true
    fi

    # Wait up to 3 seconds for /dev/video0 to enter Video Capture mode with active frames
    for i in $(seq 1 30); do
        if v4l2-ctl -d /dev/video0 --all 2>/dev/null | grep -qi "Video Capture"; then
            break
        fi
        sleep 0.1
    done

    # Ensure /dev/v4l directories and persistent symlinks exist
    mkdir -p /dev/v4l/by-id /dev/v4l/by-path 2>/dev/null || true
    for dev in /dev/video*; do
        if [ -e "$dev" ]; then
            idx="${dev#/dev/video}"
            ln -sf "$dev" "/dev/v4l/by-id/usb-xrdp-camera-video$idx" 2>/dev/null || true
            ln -sf "$dev" "/dev/v4l/by-path/platform-xrdp-camera-video$idx" 2>/dev/null || true
        fi
    done
fi

# 2. Deploy default working scene with /dev/video0 if scenes directory is missing or empty
OBS_CONFIG_DIR="$HOME/.config/obs-studio"
SCENES_DIR="$OBS_CONFIG_DIR/basic/scenes"
PROFILES_DIR="$OBS_CONFIG_DIR/basic/profiles/Untitled"

mkdir -p "$SCENES_DIR" "$PROFILES_DIR"

if [ ! -f "$OBS_CONFIG_DIR/global.ini" ]; then
    cat << 'EOF' > "$OBS_CONFIG_DIR/global.ini"
[General]
FirstRun=false
Pre271DefaultsApplied=true

[Basic]
Profile=Untitled
ProfileDir=Untitled
SceneCollection=Untitled
SceneCollectionFile=Untitled

[BasicWindow]
cx=1280
cy=720
EOF
fi

if [ ! -f "$PROFILES_DIR/basic.ini" ]; then
    cat << 'EOF' > "$PROFILES_DIR/basic.ini"
[General]
Name=Untitled

[Video]
BaseCX=1920
BaseCY=1080
OutputCX=1920
OutputCY=1080
FPSType=0
FPSCommon=30
EOF
fi

if [ ! -f "$SCENES_DIR/Untitled.json" ]; then
    cat << 'EOF' > "$SCENES_DIR/Untitled.json"
{
    "current_program_scene": "Camera",
    "current_scene": "Camera",
    "name": "Untitled",
    "sources": [
        {
            "id": "v4l2_input",
            "name": "Webcam",
            "settings": {
                "device_id": "/dev/video0",
                "input": 0,
                "buffering": true
            },
            "enabled": true,
            "muted": false
        },
        {
            "id": "scene",
            "name": "Camera",
            "settings": {
                "custom_size": false,
                "id_counter": 1,
                "items": [
                    {
                        "name": "Webcam",
                        "visible": true,
                        "locked": false,
                        "pos": {
                            "x": 0.0,
                            "y": 0.0
                        },
                        "rot": 0.0,
                        "scale": {
                            "x": 1.0,
                            "y": 1.0
                        },
                        "align": 5,
                        "bounds_type": 2,
                        "bounds_align": 0,
                        "bounds": {
                            "x": 1920.0,
                            "y": 1080.0
                        }
                    }
                ]
            }
        }
    ]
}
EOF
fi

# Sanitize any broken scenes with empty device_id that cause OBS to segfault
if ls "$SCENES_DIR"/*.json >/dev/null 2>&1; then
    sed -i 's|"device_id": ""|"device_id": "/dev/video0"|g' "$SCENES_DIR"/*.json 2>/dev/null || true
fi

# 3. Preload the V4L2 compatibility shim if available
if [ -f /usr/local/lib/libobs-v4l2-shim.so ]; then
    export LD_PRELOAD="/usr/local/lib/libobs-v4l2-shim.so${LD_PRELOAD:+:$LD_PRELOAD}"
fi

# 4. Locate and execute the real OBS executable
REAL_OBS=""
if [ -x /usr/bin/obs.real ]; then
    REAL_OBS="/usr/bin/obs.real"
elif [ -x /usr/bin/obs ] && [ ! -L /usr/bin/obs ]; then
    REAL_OBS="/usr/bin/obs"
elif [ -x /usr/bin/obs64 ]; then
    REAL_OBS="/usr/bin/obs64"
fi

if [ -n "$REAL_OBS" ]; then
    exec "$REAL_OBS" "$@"
else
    echo "Error: OBS executable not found in /usr/bin/" >&2
    exit 1
fi
